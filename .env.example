# ==============================================================
# Hloni Portfolio - Server Environment Variables
# Configure these in your Vercel Dashboard: Project Settings > Environment Variables
# ==============================================================

# GitHub Personal Access Token (Fine-grained or Classic with 'repo' / 'contents: write' scope)
# NEVER expose this token to the frontend or git commits.
GITHUB_TOKEN=

# GitHub Repository Information
GITHUB_OWNER=Hloni207
GITHUB_REPO=Hloni-Portfolio
GITHUB_BRANCH=main

# Admin Dashboard Security
# Protects /admin and /api/* publishing endpoints from unauthorized access
ADMIN_PASSWORD=hloni2026
SESSION_SECRET=hloni-portfolio-secure-session-key-2026
